-- 55) WAQTD ALL THE DETAILS OF THE EMPLOYEES ALONG WITH THAT
-- 20% HIKE OF IN THEIR SALARY FOR THE EMPLOYEES WHO HIRED
--    AFTER 85 ?
SELECT EMP1.*, SAL+(SAL*0.2) as hike FROM EMP1 
where HIREDATE >'31-DEC-85';
-- 56) WAQTD ALL THE DETAILS OF THE EMPLOYEES ALONG WITH THAT 
--      12% DEDUCTION  OF IN THEIR SALARY FOR THE EMPLOYEES WHO HIRED
--    BEFORE  84 ?
SELECT EMP1.* , SAL-(SAL*0.12) AS DEDUCTIONS  FROM EMP1
WHERE HIREDATE <'01-JAN-84';
-- 57) WAQTD ALL THE DETAILS OF THE EMPLOYEES ALONG WITH THAT 
--      2000 BONUS  OF IN THEIR SALARY FOR THE EMPLOYEES WHOSE 
--      EMPNO IS 7369 ?
SELECT EMP1.* , SAL+2000 AS BONUS  FROM EMP1
WHERE 
EMPNO =7369;

