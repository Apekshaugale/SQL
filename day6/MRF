-- 131) WAQTD MAX SALARY FROM THE EMPLOYEE TABLE ?
SELECT MAX(SAL) FROM EMP1;
-- 132) WAQTD MAX AND MIN COMM FROM EMPLOYEES TABLE ?
SELECT MAX(COMM),MIN(COMM) FROM EMP1;
-- 133) WAQTD TOTAL SALARY NEEDED TO PAY FOR THE SALESMAN ?
SELECT SUM(SAL) FROM EMP1
WHERE JOB='SALESMAN';
-- 134) WAQTD NUMBER OF EMPLOYEES WORKING IN DEPTNO 30 ?
SELECT COUNT(ENAME) FROM EMP1
WHERE DEPTNO=30;
-- 135) WAQTD NUMBER OF EMPLOYEES WORKING AS MANAGER IN DEPTNO 20?
SELECT COUNT(ENAME) FROM EMP1
WHERE DEPTNO=20;
-- 136) WAQTD MAX SALARY NEEDED TO PAY FOR THE EMPLOYEES WHOSE NAME STARTS WITH A ?
SELECT MAX(SAL) FROM EMP1
WHERE ENAME LIKE 'A%';
-- 137) WAQTD AVG SALARY NEEDED TO PAY FOR THE EMPLOYEES OF DEPTNO 10 ?
SELECT AVG(SAL) FROM EMP1
WHERE DEPTNO=10;
-- 138) WAQTD TOTAL SALARY AND AVG SALARY NEEDED TO PAY FOR THE EMPLOYEES WHO ARE HIRED IN THE RANGE OF 81 TO 87 ?
SELECT SUM(SAL),AVG(SAL) FROM EMP1
WHERE HIREDATE BETWEEN '01-JAN-81'AND '31-DEC-87';
-- 139) WAQTD NUMBER OF EMPLOYEES WORKING IN DEPTNO 40 ?
SELECT COUNT(ENAME) FROM EMP1 WHERE DEPTNO=40;

-- 142) WAQTD HOW MANY EMPLOYEES ARE WORKIN AS SALESMAN IN DEPTNO 30 AND EARNING SALARY LESS THEN 5000 ?
SELECT COUNT(ENAME) FROM EMP1 
WHERE JOB='SALESMAN' AND DEPTNO=30 AND SAL<5000;




 

